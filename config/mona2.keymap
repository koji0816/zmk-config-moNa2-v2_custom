#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
/* DYA Studio から作成したマクロを呼び出す `&rmacro <slot>` を定義する。
   slot は 0 〜 CONFIG_ZMK_RUNTIME_MACRO_COUNT-1 (現状 0〜7)。
   どのマクロがどのスロットに入っているかは DYA Studio のマクロ一覧で確認する。
   キーへの割り当ては DYA Studio のキーマップエディタからも行える。 */
#include <behaviors/runtime_macro.dtsi>
/* デフォルトレイヤー変更 behavior `&df`。
   DYA Studio の「OSごとのデフォルトレイヤー」から設定できるほか、
   キーマップエディタで `&df DF_SEL <layer>` / `&df DF_INC` を
   任意のキーに割り当てられる。 */
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100


/ {
    behaviors {
        mg_set_0: behavior_mg_set_0 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 0";
        };

        mg_set_1: behavior_mg_set_1 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 1";
        };

        mg_set_2: behavior_mg_set_2 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 2";
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/* ─────────────────────────────────────────────────────────────
   Auto Mouse Layer (AML) の設定 (Input Processor)
   https://zenn.dev/kot149/articles/zmk-auto-mouse-layer
   ────────────────────────────────────────────────────────── */

/* トラックボール操作時にレイヤー4 (MOUSE) を有効化 */
&trackball_central_listener {
    input-processors = <&zip_temp_layer 4 10000 &mg &mouse_runtime_input_processor &scroll_runtime_input_processor &zip_scroll_scaler 1 100 &inertial_scroll>;
};

/* キー入力直後の誤爆防止と、マウス操作中に押してもAMLを解除しないキー位置 */
&zip_temp_layer {
    require-prior-idle-ms = <200>;
    excluded-positions = <
        6   // MB4 (U)
        7   // MB3 (I)
        8   // MB5 (O)
        17  // MB1 (J)
        19  // MB2 (L)
        33 34 35 36 37 38 39 40 41 // 親指キー群
    >;
};

/* マウスクリック時にタイムアウトを更新し、クリック後250msでAMLを解除 */
&mkp_input_listener {
    input-processors = <&zip_temp_layer 4 250>;
};

/ {
    /* ─────────────────────────────────────────────────────────────
       コンボ (DYA Studio から編集可能)
       ※デフォルトの tab / layer4_ESC combo は削除済み
       ────────────────────────────────────────────────────────── */
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";
    };

    /* 静的マクロ。キーマップ上で &BT0 / &screenshot などの名前で直接
       参照しているため、そのまま残している (DYA Studio 上では編集不可)。
       DYA Studio から編集したいマクロは Web UI で新規作成し、
       キーに `&rmacro <slot>` を割り当てて使う。 */
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        macro1: macro1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp LEFT_ARROW>;
            label = "MACRO1";
        };

        macro2: macro2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW>;
            label = "MACRO2";
        };

        macro3: macro3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW>;
            label = "MACRO3";
        };

        macro_ctrl_c: macro_ctrl_c {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(C)>;
            label = "MACRO_CTRL_C";
        };

        macro_ctrl_v: macro_ctrl_v {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>;
            label = "MACRO_CTRL_V";
        };

        macro_screenshot: macro_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LG(S))>;
            label = "MACRO_SCREENSHOT";
        };

        BT0: BT0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT0";
        };

        BT1: BT1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 1>;

            label = "BT1";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };

        // エンコーダ用 runtime-configurable sensor rotate
        // デフォルトはスクロール (cw=SCRL_DOWN, ccw=SCRL_UP)
        // DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
        // kp C_VOL_UP/DN や kp LEFT/RIGHT などへ動的変更可能

        rsr_default: rsr_default {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEFAULT";
            bindings = <
&kp Q          &kp W         &kp E         &kp R                 &kp T                                                      &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A          &kp S         &kp D         &kp F                 &kp G                                       &macro_ctrl_c  &kp H        &kp J  &kp K      &kp L    &kp MINUS
&kp Z          &kp X         &kp C         &kp V                 &kp B        &kp TAB                        &macro_ctrl_v  &kp N        &kp M  &kp COMMA  &kp DOT  &kp SLASH
&mt LCTRL ESC  &kp LEFT_WIN  &kp LEFT_ALT  &mt LEFT_SHIFT LANG2  &lt 2 SPACE  &lt_to_layer_0 3 LANGUAGE_1    &kp BACKSPACE  &lt 1 ENTER                             &kp LEFT_SHIFT
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_1 {
            display-name = "NUM_NAV";
            bindings = <
&none  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &none                     &none   &none           &none     &none            &kp HOME
&none  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &none             &trans  &none   &none           &kp UP    &none            &kp END
&none  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &none   &trans    &trans  &none   &kp LEFT_ARROW  &kp DOWN  &kp RIGHT_ARROW  &kp PAGE_UP
&none  &kp NUMBER_0  &none         &trans        &trans  &trans    &trans  &trans                                             &kp PAGE_DOWN
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_2 {
            display-name = "SYMBOL";
            bindings = <
&kp EXCLAMATION   &kp AT_SIGN  &kp POUND          &kp DOLLAR  &kp PERCENT                     &kp COLON  &macro1  &kp LEFT_PARENTHESIS  &kp RPAR           &kp BACKSLASH
&kp SINGLE_QUOTE  &kp CARET    &kp AMPERSAND      &kp ASTRK   &kp EQUAL              &none    &kp SEMI   &macro2  &kp LEFT_BRACKET      &kp RIGHT_BRACKET  &kp INT_YEN
&kp TILDE         &kp GRAVE    &kp DOUBLE_QUOTES  &kp UNDER   &kp PLUS     &none     &none    &kp PIPE   &macro3  &kp LEFT_BRACE        &kp RIGHT_BRACE    &none
&none             &trans       &trans             &trans      &trans       &trans    &kp DEL  &trans                                                       &macro_screenshot
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            display-name = "FN_BT";
            bindings = <
&trans  &kp F7  &kp F8  &kp F9  &kp F10                    &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &kp F4  &kp F5  &kp F6  &kp F11            &trans  &none         &studio_unlock  &none         &none         &none
&trans  &kp F1  &kp F2  &kp F3  &kp F12  &trans    &trans  &none         &none           &none         &none         &bt BT_CLR
&trans  &trans  &trans  &trans  &trans   &trans    &trans  &trans                                                    &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
            display-name = "MOUSE";
            bindings = <
&none  &none  &none  &none  &none                  &none  &mkp MB4  &mkp MB3  &mkp MB5  &none
&none  &none  &none  &none  &none           &none  &none  &mkp MB1  &none     &mkp MB2  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none     &none     &none     &none
&none  &none  &none  &none  &none  &none    &none  &none                                &none
            >;
        };
    };
};
